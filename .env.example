# Copy this file to .env and replace the values before starting the stack.
#
# Telegram alerts are sent by Alertmanager.
# Create a bot with @BotFather, send a message to the bot, then get your chat_id:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=123456789

# Optional Grafana login. Change the password for any shared or public server.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
